DB_CONN=Host=your-rds-endpoint.rds.amazonaws.com;Port=5432;Database=docanalytics;Username=postgres;Password=YOUR_RDS_PW
JWT_KEY=your-32plus-char-jwt-key
JWT_ISSUER=DocAnalytics
JWT_AUDIENCE=DocAnalytics
AWS_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
AWS_BEDROCK_REGION=us-east-1
AWS_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...


# --- Security (Round 0) ---
Security__Cors__AllowedOrigins__0=http://localhost:4200
Security__Hsts__Enabled=false
Security__ForwardedHeaders__Enabled=true
# In real deploy, add the public origin:
# Security__Cors__AllowedOrigins__1=https://app.yourdomain.com
# Security__Hsts__Enabled=true

