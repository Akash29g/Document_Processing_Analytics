        <div class="dup-actions">
          <button class="dup-btn danger" (click)="dup.choose('replace')">Replace existing</button>
          <button class="dup-btn primary" (click)="dup.choose('rename')">Keep both</button>
          <button class="dup-btn ghost" (click)="dup.choose('skip')">Skip this file</button>
        </div>
      </div>
    </div>
  }
</section>
