<section class="page">
  <header class="page-head">
    <h2 class="page-title">Batches</h2>
    <p class="page-sub">Browse and inspect document batches for this site.</p>
  </header>

  <div class="toolbar">
    <app-filter-bar
      [statusOptions]="statusOptions"
      [sourceOptions]="sourceOptions()"
      (changed)="onFilters($event)"
    />
    <input
      class="search-input"
      type="search"
      placeholder="Search by Batch ID…"
      [value]="svc.query().search ?? ''"
      (input)="onSearch($event)"
    />
  </div>

  <app-data-table
    [columns]="columns"
    [rows]="svc.batches()"
    [loading]="svc.loading()"
    [error]="svc.error()"
    emptyMessage="No batches match your filters."
    [sortBy]="svc.query().sortBy"
    [sortDir]="svc.query().sortDir"
    [page]="svc.query().page"
    [pageSize]="svc.query().pageSize"
    [totalCount]="svc.meta()?.total_count ?? 0"
    [totalPages]="svc.meta()?.total_pages ?? 1"
    (sortChange)="onSort($event)"
    (pageChange)="svc.setPage($event)"
    (pageSizeChange)="svc.setPageSize($event)"
    (retry)="svc.loadBatches()"
  >
    <ng-template dtCell="transaction_id" let-row>
      <a class="batch-link" [routerLink]="[row.transaction_id]">{{ row.transaction_id }}</a>
    </ng-template>

    <ng-template dtCell="state" let-row>
      <app-status-badge [status]="row.state" />
    </ng-template>

    <ng-template dtCell="actions" let-row>
      @if (isAdmin()) {
        <button
          class="dup-btn ghost"
          (click)="confirmDelete(row.transaction_id); $event.stopPropagation()"
          title="Delete batch"
        >
          🗑️
        </button>
      }
    </ng-template>

    <ng-template dtCell="submitted_at" let-row>
      {{ row.submitted_at | date: 'medium' }}
    </ng-template>

    <ng-template dtCell="last_updated" let-row>
      {{ row.last_updated_at | date: 'medium' }}
    </ng-template>
  </app-data-table>
</section>

@if (pendingDelete(); as id) {
  <div class="dup-backdrop">
    <div class="dup-modal" role="dialog" aria-modal="true">
      <h3 class="dup-title">Delete batch?</h3>
      <p class="dup-msg">
        This permanently deletes the batch, all its files, extracted data,
        <strong>and the PDFs in S3</strong>. This cannot be undone.
      </p>
      <div class="dup-actions">
        <button class="dup-btn ghost" (click)="pendingDelete.set(null)">Cancel</button>
        <button class="dup-btn danger" (click)="doDelete()">Delete permanently</button>
      </div>
    </div>
  </div>
}
</file>

