{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Jwt": {
    "ExpiryMinutes": 20
  },

  "Security": {
    "Cors": {
      "AllowedOrigins": [ "https://docanalytics.dev" ]
    },
    "Hsts": {
      "Enabled": true,
      "MaxAgeDays": 365,
      "IncludeSubDomains": true,
      "Preload": true
    },
    "ForwardedHeaders": { "Enabled": true }
  }
}
